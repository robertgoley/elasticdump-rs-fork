{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.7",
  "small_model": "xai/grok-4.7",
  "enabled_providers": [
    "xai"
  ],
  "default_agent": "impl",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "xai": {
      "options": {
        "timeout": 1800000
      },
      "whitelist": [
        "grok-4.7"
      ]
    }
  },
  "watcher": {
    "ignore": [
      "**/target/**",
      "fuzz/corpus/**",
      "fuzz/artifacts/**",
      "fuzz/target/**"
    ]
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "edit": "deny",
    "bash": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny",
    "lsp": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": "deny"
  },
  "agent": {
    "impl": {
      "description": "Bounded code or test change from one task card, inside one git worktree (edit limited to files_allowed)",
      "mode": "primary",
      "model": "xai/grok-4.7",
      "prompt": "{file:./prompts/impl.md}",
      "steps": 150,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "edit": "deny",
        "external_directory": {
          "*": "deny",
          "/tmp/*": "allow"
        },
        "bash": {
          "*": "deny",
          "cargo build*": "allow",
          "cargo check*": "allow",
          "cargo test*": "allow",
          "cargo nextest run*": "allow",
          "cargo nextest list*": "allow",
          "cargo fmt*": "allow",
          "cargo clippy*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git rev-parse*": "allow",
          "ls*": "allow",
          "wc *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "sed -n *": "allow",
          "true": "allow",
          "cargo install*": "deny",
          "cargo add*": "deny",
          "cargo remove*": "deny",
          "cargo update*": "deny",
          "cargo publish*": "deny",
          "cargo vendor*": "deny",
          "git push*": "deny",
          "git remote*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git worktree*": "deny",
          "git branch*": "deny",
          "git stash*": "deny",
          "git tag*": "deny",
          "git config*": "deny",
          "git commit --amend*": "deny",
          "git commit --no-verify*": "deny",
          "mkdir -p results/cards*": "allow",
          "podman*": "deny",
          "scripts/it/*": "deny",
          "./scripts/it/*": "deny",
          "docker*": "deny",
          "curl*": "deny",
          "wget*": "deny"
        }
      }
    },
    "runner": {
      "description": "Campaign lane: scripts already ran the commands; summarise logs into results/ only, no source edits",
      "mode": "primary",
      "model": "xai/grok-4.7",
      "prompt": "{file:./prompts/runner.md}",
      "steps": 80,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "edit": {
          "*": "deny",
          "results/*": "allow",
          "*/results/*": "allow"
        },
        "external_directory": "deny",
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "wc *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "sed -n *": "allow",
          "jq *": "allow",
          "sha256sum *": "allow",
          "python3 scripts/load/measure.py --validate*": "allow",
          "python3 -m json.tool*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add results/*": "allow",
          "git commit *": "allow",
          "mkdir -p results/*": "allow",
          "cargo +nightly fuzz tmin*": "allow",
          "git push*": "deny",
          "git commit --amend*": "deny",
          "git commit --no-verify*": "deny",
          "podman*": "deny",
          "curl*": "deny",
          "wget*": "deny"
        }
      }
    },
    "review": {
      "description": "Read-only hostile-code review of git diff rewrite...<branch> in a fresh session; never the session that wrote it",
      "mode": "primary",
      "model": "xai/grok-4.7",
      "prompt": "{file:./prompts/review.md}",
      "steps": 80,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "edit": "deny",
        "external_directory": {
          "*": "deny",
          "/tmp/*": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "git rev-parse*": "allow",
          "git merge-base*": "allow",
          "ls*": "allow",
          "wc *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "sed -n *": "allow",
          "jq *": "allow",
          "cargo test*": "allow",
          "cargo nextest run*": "allow",
          "cargo nextest list*": "allow",
          "cargo build*": "allow",
          "cargo check*": "allow",
          "cargo clippy*": "allow",
          "cargo fmt --all -- --check*": "allow",
          "git push*": "deny",
          "git commit*": "deny",
          "git add*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git merge *": "deny",
          "git stash*": "deny",
          "git branch*": "deny",
          "git config*": "deny",
          "git remote*": "deny",
          "cargo install*": "deny",
          "cargo add*": "deny",
          "cargo update*": "deny",
          "podman*": "deny",
          "curl*": "deny",
          "wget*": "deny"
        }
      }
    },
    "lead": {
      "description": "Interactive session supervised by the user: security-sensitive code, design decisions, merges, bundle cuts",
      "mode": "primary",
      "model": "xai/grok-4.7",
      "prompt": "{file:./prompts/lead.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "edit": "ask",
        "webfetch": "ask",
        "external_directory": "ask",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "cargo build*": "allow",
          "cargo check*": "allow",
          "cargo test*": "allow",
          "cargo nextest*": "allow",
          "cargo fmt*": "allow",
          "cargo clippy*": "allow",
          "ls*": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git push*": "deny",
          "git remote*": "deny",
          "git commit --no-verify*": "deny"
        }
      }
    }
  }
}
