# Only Cargo.toml, Cargo.lock, src/, tests/, tools/ (workspace members) and the host-vendored
# crates in .vendor/ (L-808i) are needed to build.
target/
**/target/
.git/
.github/
.worktrees/
.agent/
docs/
bench/
scripts/
oom
*.json
!tests/**/*.json
*.jsonl
!tests/**/*.jsonl
*.zst
*.gz
*.md
!THIRD-PARTY-NOTICES.md
Dockerfile
Makefile
.dockerignore
docker-compose.yaml
# Host-vendored crates (scripts/vendor-crates.sh): the offline image build needs all of it,
# including crate files the patterns above would drop (e.g. cc's src/target/, *.json checksums).
!.vendor/
!.vendor/**
.vendor/vendor.log
