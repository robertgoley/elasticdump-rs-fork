{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elasticdump-rs/load-metrics/v1",
  "title": "elasticdump-rs load metrics (TST-INF-006, TST-LOAD-003)",
  "type": "object",
  "required": ["schema", "run_id", "started", "command", "exit_code", "wall_s", "user_s", "sys_s", "cpu_s",
               "max_rss_kb", "rss_peak_kb_sampled", "fds_peak", "threads_peak", "vol_ctx_switches", "invol_ctx_switches",
               "read_bytes", "write_bytes", "docs", "docs_per_s", "input_bytes", "output_bytes", "mb_per_s_in", "mb_per_s_out",
               "compression_ratio", "total_writes", "failed_writes", "retries", "cluster", "host", "labels"],
  "properties": {
    "schema": {"const": "edrs-metrics/v1"},
    "run_id": {"type": "string"},
    "started": {"type": "string"},
    "command": {"type": "array", "items": {"type": "string"}},
    "exit_code": {"type": "integer"},
    "wall_s": {"type": "number"},
    "user_s": {"type": "number"},
    "sys_s": {"type": "number"},
    "cpu_s": {"type": "number"},
    "max_rss_kb": {"type": "integer"},
    "rss_peak_kb_sampled": {"type": "integer"},
    "fds_peak": {"type": "integer"},
    "threads_peak": {"type": "integer"},
    "vol_ctx_switches": {"type": "integer"},
    "invol_ctx_switches": {"type": "integer"},
    "read_bytes": {"type": ["integer", "null"]},
    "write_bytes": {"type": ["integer", "null"]},
    "docs": {"type": ["integer", "null"]},
    "docs_per_s": {"type": ["number", "null"]},
    "input_bytes": {"type": ["integer", "null"]},
    "output_bytes": {"type": ["integer", "null"]},
    "mb_per_s_in": {"type": ["number", "null"]},
    "mb_per_s_out": {"type": ["number", "null"]},
    "compression_ratio": {"type": ["number", "null"]},
    "total_writes": {"type": ["integer", "null"]},
    "failed_writes": {"type": ["integer", "null"]},
    "retries": {"type": "object", "additionalProperties": {"type": "integer"}},
    "cluster": {"type": ["object", "null"]},
    "host": {"type": "object"},
    "labels": {"type": "object"}
  }
}
